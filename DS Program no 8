Program 8: Write a program for implement Insertion Sort

#include <stdio.h>

int main() {
    int arr[50], n, i, j, key;

    printf("=== Insertion Sort Program ===\n");

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("\nEnter %d elements:\n", n);
    for (i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    printf("\n>>> Performing Insertion Sort...\n");

    // Insertion Sort Algorithm
    for (i = 1; i < n; i++) {
        key = arr[i];
        j = i - 1;

        // Move elements greater than key
        while (j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            j--;
        }
        arr[j + 1] = key;
    }

    printf("\n>>> Sorted Output\n");
    printf("Ascending Order => ");
    for (i = 0; i < n; i++)
        printf("%d ", arr[i]);

    printf("\n\nProcess completed.\n");

    return 0;
}


