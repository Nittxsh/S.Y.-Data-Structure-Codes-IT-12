Program 8: Write a program for implement Insertion Sort

1.     Start
2.     Read the number of elements n
3.     Read n elements into an array A[0..n-1]
4.     Repeat for i = 1 to n-1:
1.     Set key = A[i]
2.     Set j = i - 1
3.     While j >= 0 and A[j] > key:
§  Move A[j] to position A[j + 1]
§  Decrement j by 1
4.     Place the key at position A[j + 1]
5.     End loop
6.     Print the sorted array
7. 	Stop

#include <stdio.h>

int main() {
    int arr[50], n, i, j, key;

    printf("=== Insertion Sort Program ===\n");

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("\nEnter %d elements:\n", n);
    for (i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    printf("\n>>> Performing Insertion Sort...\n");

    // Insertion Sort Algorithm
    for (i = 1; i < n; i++) {
        key = arr[i];
        j = i - 1;

        // Move elements greater than key
        while (j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            j--;
        }
        arr[j + 1] = key;
    }

    printf("\n>>> Sorted Output\n");
    printf("Ascending Order => ");
    for (i = 0; i < n; i++)
        printf("%d ", arr[i]);

    printf("\n\nProcess completed.\n");

    return 0;
}


