Program 3: Menu-driven program for a Singly Linked List (SLL) with the following operations

Algorithm: 
1. Initialization
Define a structure Node with fields:
data → stores element
next → pointer to next node
Initialize head = NULL (list is empty).

2. Insert at Beginning
Algorithm:
Allocate memory for a new node.
Read the value to be inserted.
Set newNode->data = value.
Set newNode->next = head.
Update head = newNode.
Print "value inserted at beginning".
Time Complexity: O(1)

3. Delete from Beginning
Algorithm:
If head == NULL → Print "List is empty. Cannot delete".
Else:
Set temp = head.
Print "temp->data deleted from beginning".
Update head = head->next.
Free the memory of temp.
Time Complexity: O(1)

4. Display
Algorithm:
If head == NULL → Print "List is empty".
Else:
Set temp = head.
While temp != NULL:
Print temp->data.
Move temp = temp->next.
Print "NULL" at the end.
Time Complexity: O(n)

5. Main Menu (Driver)
Algorithm:
Repeat until user chooses Exit:
Print menu:
1 → Insert at Beginning
2 → Delete from Beginning
3 → Display
4 → Exit
Input choice.
If choice = 1 → Call insertAtBeginning().
If choice = 2 → Call deleteFromBeginning().
If choice = 3 → Call display().
If choice = 4 → Terminate program.
Else → Print "Invalid choice"

#include <stdio.h>
#include <stdlib.h>

// Define a node structure
struct Node {
    int data;
    struct Node* next;
};

struct Node* head = NULL;   // Initially list is empty

// Function to insert a node at the end (changed)
void insertAtEnd(int value) {
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    newNode->data = value;
    newNode->next = NULL;

    if (head == NULL) {
        head = newNode;
    } else {
        struct Node* temp = head;
        while (temp->next != NULL) {
            temp = temp->next;
        }
        temp->next = newNode;
    }
    printf("%d inserted at end.\n", value);
}

// Function to delete a node from the end
void deleteFromEnd() {
    if (head == NULL) {
        printf("List is empty. Cannot delete.\n");
        return;
    }
    if (head->next == NULL) {
        printf("%d deleted from end.\n", head->data);
        free(head);
        head = NULL;
        return;
    }
    struct Node* temp = head;
    struct Node* prev = NULL;
    while (temp->next != NULL) {
        prev = temp;
        temp = temp->next;
    }
    printf("%d deleted from end.\n", temp->data);
    prev->next = NULL;
    free(temp);
}

// Function to reverse the list (in-place)
void reverseList() {
    struct Node *prev = NULL, *current = head, *next = NULL;
    while (current != NULL) {
        next = current->next;
        current->next = prev;
        prev = current;
        current = next;
    }
    head = prev;
    printf("List reversed.\n");
}

// Function to display the list
void display() {
    if (head == NULL) {
        printf("List is empty.\n");
        return;
    }
    printf("Linked List: ");
    struct Node* temp = head;
    while (temp != NULL) {
        printf("%d -> ", temp->data);
        temp = temp->next;
    }
    printf("NULL\n");
}

// Main program with menu
int main() {
    int choice, value;
    while (1) {
        printf("\n--- Singly Linked List Menu (Modified) ---\n");
        printf("1. Insert at End\n");
        printf("2. Delete from End\n");
        printf("3. Display\n");
        printf("4. Reverse List\n");
        printf("5. Exit\n");
        printf("Enter your choice: ");
        if (scanf("%d", &choice) != 1) { // simple input validation
            printf("Invalid input. Exiting.\n");
            break;
        }

        switch (choice) {
            case 1:
                printf("Enter value to insert: ");
                scanf("%d", &value);
                insertAtEnd(value);
                break;
            case 2:
                deleteFromEnd();
                break;
            case 3:
                display();
                break;
            case 4:
                reverseList();
                break;
            case 5:
                exit(0);
            default:
                printf("Invalid choice! Try again.\n");
        }
    }
    return 0;
}

